     "type": "string",
     "description": "Logs Insights query"
    },
    "start_time": {
     "type": "string",
     "description": "ISO start"
    },
    "end_time": {
     "type": "string",
     "description": "ISO end"
    }
   },
   "required": [
    "log_group_names",
    "query_string"
   ]
  }
 },
 {
