[
 {
  "name": "kubectl_get",
  "description": "Get or list Kubernetes resources (pods, nodes, deployments, events, priorityclasses, namespaces, replicasets). Equivalent to `kubectl get <resourceType> [name] -n <namespace> [-o output]`.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "resourceType": {
     "type": "string",
     "description": "Resource type, e.g. pods, nodes, deployments, events"
    },
    "name": {
     "type": "string",
     "description": "Resource name (optional)"
    },
    "namespace": {
     "type": "string",
     "description": "Namespace (optional)"
    },
    "allNamespaces": {
     "type": "boolean",
     "description": "List across all namespaces"
    },
    "output": {
     "type": "string",
     "description": "Output format, e.g. wide or json"
    },
    "labelSelector": {
     "type": "string",
     "description": "Label selector"
    },
    "fieldSelector": {
     "type": "string",
     "description": "Field selector, e.g. spec.nodeName=<node>"
    }
   },
   "required": [
    "resourceType"
   ]
  }
 },
 {
  "name": "kubectl_describe",
  "description": "Describe a Kubernetes resource in detail (`kubectl describe <resourceType> <name>`).",
  "inputSchema": {
   "type": "object",
   "properties": {
    "resourceType": {
     "type": "string",
     "description": "Resource type"
    },
    "name": {
     "type": "string",
     "description": "Resource name"
    },
    "namespace": {
     "type": "string",
     "description": "Namespace"
    }
   },
   "required": [
    "resourceType",
    "name"
   ]
  }
 },
 {
  "name": "kubectl_top",
  "description": "Show CPU and memory usage for nodes or pods (`kubectl top nodes|pods`).",
  "inputSchema": {
   "type": "object",
   "properties": {
    "resource": {
     "type": "string",
     "description": "nodes or pods"
    },
    "name": {
     "type": "string",
     "description": "Name (optional)"
    },
    "namespace": {
     "type": "string",
     "description": "Namespace (optional)"
    },
    "allNamespaces": {
     "type": "boolean",
     "description": "All namespaces"
    },
    "sortBy": {
     "type": "string",
     "description": "cpu or memory"
    }
   },
   "required": [
    "resource"
   ]
  }
 },
 {
  "name": "kubectl_logs",
  "description": "Get logs from a pod (`kubectl logs <pod> -n <namespace>`).",
  "inputSchema": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string",
     "description": "Pod name"
    },
    "namespace": {
     "type": "string",
     "description": "Namespace"
    },
    "tail": {
     "type": "integer",
     "description": "Lines"
    }
   },
   "required": [
    "name"
   ]
  }
 },
 {
  "name": "kubectl_scale",
  "description": "Scale a deployment or statefulset (`kubectl scale <resourceType>/<name> --replicas=N`). Modifies cluster state.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string",
