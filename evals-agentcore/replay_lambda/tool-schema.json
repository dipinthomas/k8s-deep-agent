    },
    "replicas": {
     "type": "integer",
     "description": "Desired replicas"
    },
    "namespace": {
     "type": "string",
     "description": "Namespace"
    },
    "resourceType": {
     "type": "string",
     "description": "deployment or statefulset"
    }
   },
   "required": [
    "name",
    "replicas"
   ]
  }
 },
