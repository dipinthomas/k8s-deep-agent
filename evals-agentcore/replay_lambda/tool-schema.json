 {
  "name": "get_metric_data",
  "description": "Fetch CloudWatch metric datapoints for a namespace, metric name and dimensions over a time window.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "namespace": {
     "type": "string",
     "description": "Metric namespace, e.g. RetailProd/Services"
    },
    "metric_name": {
     "type": "string",
     "description": "Metric name, e.g. LatencyP99, ErrorRate, CPUUtilization"
    },
    "dimensions": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "Name": {
        "type": "string"
       },
       "Value": {
        "type": "string"
       }
      }
     },
     "description": "Dimensions"
    },
    "start_time": {
     "type": "string",
     "description": "ISO start"
    },
    "end_time": {
     "type": "string",
     "description": "ISO end"
    },
    "statistic": {
     "type": "string",
     "description": "Statistic"
    },
    "period": {
     "type": "integer",
     "description": "Period seconds"
    }
   },
   "required": [
    "namespace",
    "metric_name"
   ]
  }
 },
 {
