# Local environment (loaded by `agentcore dev`; never commit secrets)
.env.local
.env*.local

# Python
__pycache__/
*.py[cod]
.venv/

# Node
node_modules/

# AgentCore CLI state (deployed-state.json holds your account's ARNs: never commit)
agentcore/.cli/

# AgentCore build cache (CodeZip dependency staging)
agentcore/.cache/

# CDK
agentcore/cdk/cdk.out/
agentcore/cdk/node_modules/

# Your account + region (written by scripts/setup_replay.py)
agentcore/aws-targets.json
